worker_processes ${WORKERS};
daemon off;
pid ${RUN_DIR}/nginx.pid;
error_log ${RUN_DIR}/nginx.error.log;

events {
    worker_connections ${WORKER_CONNECTIONS};
}

http {
    client_body_temp_path ${RUN_DIR}/client_body_temp;
    proxy_temp_path ${RUN_DIR}/proxy_temp;
    fastcgi_temp_path ${RUN_DIR}/fastcgi_temp;
    uwsgi_temp_path ${RUN_DIR}/uwsgi_temp;
    scgi_temp_path ${RUN_DIR}/scgi_temp;

    log_format testbed '$msec\t$remote_addr\t$server_name\t$status\t$request_time\t$upstream_response_time\t$limit_req_status\t$sent_http_x_key';
    access_log ${RUN_DIR}/nginx.access.log testbed;

    limit_req_status 429;

    upstream ${UPSTREAM_NAME} {
        server ${UPSTREAM_ADDR};
        keepalive ${UPSTREAM_KEEPALIVE};
    }

    include ${RUN_DIR}/run.key.conf;
}
