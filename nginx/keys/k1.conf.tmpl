limit_req_zone $binary_remote_addr zone=k1:${ZONE_SIZE} rate=${R}r/s;

server {
    server_name k1;
    listen ${LISTEN_HOST}:${PORT};
    ${LISTEN6_LINE}
    ${LAN_LISTEN_LINE}

    location / {
        limit_req zone=k1 burst=${BURST} ${QUEUE_FLAG};
        add_header X-Key $remote_addr always;
        proxy_pass http://${UPSTREAM_NAME};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }
}
