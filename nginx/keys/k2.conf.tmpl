map $binary_remote_addr $k2key {
    ~(?s)^(...).\z $1;
    ~(?s)^(........)........\z $1;
    default $remote_addr;
}

map $k2key $k2key_safe {
    ~(?s)^(.+)\z $1;
    default EMPTY_$remote_addr;
}

limit_req_zone $k2key_safe zone=k2:${ZONE_SIZE} rate=${R}r/s;

server {
    server_name k2;
    listen ${LISTEN_HOST}:${PORT};
    ${LISTEN6_LINE}
    ${LAN_LISTEN_LINE}

    location / {
        limit_req zone=k2 burst=${BURST} ${QUEUE_FLAG};
        set $testbed_key $k2key_safe;
        proxy_pass http://${UPSTREAM_NAME};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }
}
