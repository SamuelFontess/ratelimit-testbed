include ${RUN_DIR}/k2_prefix.conf;

limit_req_zone $k2key_safe zone=k2:${ZONE_SIZE} rate=${R}r/s;

server {
    server_name k2;
    listen ${LISTEN_HOST}:${PORT};
    ${LISTEN6_LINE}
    ${LAN_LISTEN_LINE}

    location / {
        limit_req zone=k2 burst=${BURST} ${QUEUE_FLAG};
        set $testbed_key $k2key_safe;
        proxy_pass http://${UPSTREAM_NAME};
        proxy_http_version 1.1;
        proxy_set_header Connection "";
    }
}
